{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musomo Tracker",
  "version": "1.3.31",
  "identifier": "net.musomo.tracker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Musomo Tracker",
        "url": "tracker-studio/index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "maximized": false,
        "closable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Stefano Solda (GPVK8LH6KG)",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    }
  }
}
